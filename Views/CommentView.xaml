<Page x:Class="EZ.FACEBOOK.TOOL.Views.CommentView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Auto Comment">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Danh sách tài khoản -->
            <TextBlock Text="Danh sách tài khoản" 
                       FontSize="16" 
                       Margin="0,0,0,10"/>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Accounts}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      MaxHeight="200"
                      Margin="0,0,0,20">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Chọn" 
                                          Binding="{Binding IsSelected}"
                                          Width="60"/>
                    <DataGridTextColumn Header="Tài khoản" 
                                      Binding="{Binding Username}"
                                      Width="*"/>
                    <DataGridTextColumn Header="Trạng thái" 
                                      Binding="{Binding Status}"
                                      Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Nội dung comment và hình ảnh -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Nội dung comment -->
                <StackPanel>
                    <TextBlock Text="Nội dung comment" 
                               FontSize="16" 
                               Margin="0,0,0,10"/>
                    <TextBox Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}"
                             Height="100"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- Hình ảnh -->
                <StackPanel Grid.Column="1" 
                            Margin="20,0,0,0">
                    <TextBlock Text="Hình ảnh" 
                               FontSize="16" 
                               Margin="0,0,0,10"/>
                    <Button Content="Thêm ảnh" 
                            Command="{Binding AddImagesCommand}"
                            Padding="10,5"
                            Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding SelectedImages}"
                             Height="200"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="100"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,10,5"/>
                                        <Button Grid.Column="1"
                                                Content="X"
                                                Command="{Binding DataContext.RemoveImageCommand, 
                                                         RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Padding="5,0"/>
                                    </Grid>
                                    <Image Grid.Row="1" 
                                           Source="{Binding}"
                                           Stretch="Uniform"
                                           MaxHeight="100"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>

            <!-- Delay -->
            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <TextBlock Text="Thời gian delay (giây)" 
                           FontSize="16" 
                           Margin="0,0,0,10"/>
                <TextBox Text="{Binding DelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                         Width="100"
                         HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- URLs -->
            <StackPanel Grid.Row="4" Margin="0,0,0,20">
                <TextBlock Text="Danh sách URL nhóm (mỗi dòng 1 URL)" 
                           FontSize="16" 
                           Margin="0,0,0,10"/>
                <TextBox Text="{Binding GroupUrls, UpdateSourceTrigger=PropertyChanged}"
                         Height="100"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Nút bắt đầu -->
            <Button Grid.Row="5"
                    Content="Bắt đầu"
                    Command="{Binding StartCommand}"
                    IsEnabled="{Binding CanStart}"
                    Width="150"
                    Height="40"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Left"/>
        </Grid>
    </ScrollViewer>
</Page> 